/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a multi-tenant data model where teachers manage students and their associated data.
 *
 * Data Structure:
 * - /announcements/{announcementId}: Public announcements visible to all users.
 * - /teachers/{teacherId}: Teacher profiles, where {teacherId} is the Firebase auth UID.
 * - /teachers/{teacherId}/students/{studentId}: Student profiles managed by a teacher.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}: Daily reports for a student.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}: Subject-specific items for a daily report.
 * - /teachers/{teacherId}/messages/{messageId}: Messages from a teacher to all students.
 * - /teachers/{teacherId}/students/{studentId}/messages/{messageId}: Messages from a teacher to a specific student.
 *
 * Key Security Decisions:
 * - Teachers can only manage their own profiles.
 * - Teachers can manage student profiles and associated data (daily reports, subject items) under their teacher ID.
 * - Public announcements are readable by everyone.
 * - Students cannot directly access teacher or other student data.
 *
 * Denormalization for Authorization:
 * - Student and DailyReport documents contain denormalized 'teacherId' and 'studentId' fields to avoid costly `get()` calls during authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements, but only allows teachers to create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn() && request.auth.uid == resource.data.teacherId
     * @deny (create): if !isSignedIn() // Must be signed in to create an announcement
     * @deny (update): if resource == null //Cannot update a non-existent document
     * @deny (delete): if resource == null //Cannot delete a non-existent document
     * @principle Allows public read access while restricting write access to authorized teachers.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.teacherId && resource != null;
    }

    /**
     * @description Allows a teacher to manage their own profile.
     * @path /teachers/{teacherId}
     * @allow (get): if isSignedIn() && isOwner(teacherId)
     * @allow (list): if false; // Prevent listing of all teachers
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isExistingOwner(teacherId)
     * @allow (delete): if isExistingOwner(teacherId)
     * @deny (create): if request.auth.uid != teacherId; // Only allow creating the teacher doc with the teacher's own uid
     * @deny (update): if resource == null //Cannot update a non-existent document
     * @deny (delete): if resource == null //Cannot delete a non-existent document
     * @principle Enforces document ownership for teacher profiles.
     */
    match /teachers/{teacherId} {
      allow get: if isSignedIn() && isOwner(teacherId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage student profiles under their teacher ID.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): if isSignedIn() && isOwner(teacherId)
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @allow (delete): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @deny (create): if request.resource.data.teacherId != teacherId; // Enforce teacherId consistency on create
     * @deny (update): if request.resource.data.teacherId != resource.data.teacherId; // Enforce teacherId immutability
     * @deny (update): if resource == null //Cannot update a non-existent document
     * @deny (delete): if resource == null //Cannot delete a non-existent document
     * @principle Enforces teacher-based ownership for student profiles.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isOwner(teacherId) && resource != null;
      allow delete: if isSignedIn() && isOwner(teacherId) && resource != null;
    }

    /**
     * @description Allows a teacher to manage daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list): if isSignedIn() && isOwner(teacherId)
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @allow (delete): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @deny (create): if request.resource.data.teacherId != teacherId; // Enforce teacherId consistency on create
     * @deny (create): if request.resource.data.studentId != studentId; // Enforce studentId consistency on create
     * @deny (update): if request.resource.data.teacherId != resource.data.teacherId; // Enforce teacherId immutability
     * @deny (update): if request.resource.data.studentId != resource.data.studentId; // Enforce studentId immutability
     * @deny (update): if resource == null //Cannot update a non-existent document
     * @deny (delete): if resource == null //Cannot delete a non-existent document
     * @principle Enforces teacher-based ownership for student daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isOwner(teacherId) && resource != null;
      allow delete: if isSignedIn() && isOwner(teacherId) && resource != null;
    }

    /**
     * @description Allows a teacher to manage subject items for a student's daily report.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): if isSignedIn() && isOwner(teacherId)
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @allow (delete): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @deny (create): if request.resource.data.teacherId != teacherId; // Enforce teacherId consistency on create
     * @deny (create): if request.resource.data.studentId != studentId; // Enforce studentId consistency on create
     * @deny (create): if request.resource.data.dailyReportId != dailyReportId; // Enforce dailyReportId consistency on create
     * @deny (update): if request.resource.data.teacherId != resource.data.teacherId; // Enforce teacherId immutability
     * @deny (update): if request.resource.data.studentId != resource.data.studentId; // Enforce studentId immutability
     * @deny (update): if request.resource.data.dailyReportId != resource.data.dailyReportId; // Enforce dailyReportId immutability
     * @deny (update): if resource == null //Cannot update a non-existent document
     * @deny (delete): if resource == null //Cannot delete a non-existent document
     * @principle Enforces teacher-based ownership for subject items within daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isOwner(teacherId) && resource != null;
      allow delete: if isSignedIn() && isOwner(teacherId) && resource != null;
    }

    /**
     * @description Allows a teacher to manage messages sent to all of their students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get, list): if isSignedIn() && isOwner(teacherId);
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @allow (delete): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @deny (create): if request.resource.data.teacherId != teacherId; // Enforce teacherId consistency on create
     * @deny (update): if request.resource.data.teacherId != resource.data.teacherId; // Enforce teacherId immutability
     * @deny (update): if resource == null //Cannot update a non-existent document
     * @deny (delete): if resource == null //Cannot delete a non-existent document
     * @principle Enforces teacher-based ownership for messages sent to all students.
     */
    match /teachers/{teacherId}/messages/{messageId} {
       allow get, list: if isSignedIn() && isOwner(teacherId);
       allow create: if isSignedIn() && isOwner(teacherId);
       allow update: if isSignedIn() && isOwner(teacherId) && resource != null;
       allow delete: if isSignedIn() && isOwner(teacherId) && resource != null;
    }

    /**
     * @description Allows a teacher to manage messages sent to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get, list): if isSignedIn() && isOwner(teacherId);
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @allow (delete): if isSignedIn() && isOwner(teacherId) && resource != null;
     * @deny (create): if request.resource.data.teacherId != teacherId; // Enforce teacherId consistency on create
     * @deny (create): if request.resource.data.studentId != studentId; // Enforce studentId consistency on create
     * @deny (update): if request.resource.data.teacherId != resource.data.teacherId; // Enforce teacherId immutability
     * @deny (update): if request.resource.data.studentId != resource.data.studentId; // Enforce studentId immutability
     * @deny (update): if resource == null //Cannot update a non-existent document
     * @deny (delete): if resource == null //Cannot delete a non-existent document
     * @principle Enforces teacher-based ownership for messages sent to a specific student.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get, list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isOwner(teacherId) && resource != null;
      allow delete: if isSignedIn() && isOwner(teacherId) && resource != null;
    }
  }
}

/**
 * @description Checks if the user is signed in.
 * @return {boolean} True if the user is signed in, false otherwise.
 */
function isSignedIn() {
  return request.auth != null;
}

/**
 * @description Checks if the authenticated user's UID matches the provided userId.
 * @param {string} userId The user ID to compare against the authenticated user's UID.
 * @return {boolean} True if the user is the owner, false otherwise.
 */
function isOwner(userId) {
  return request.auth.uid == userId;
}

/**
 * @description Checks if the authenticated user is the owner of the document and the document exists.
 * @param {string} userId The user ID to compare against the authenticated user's UID.
 * @return {boolean} True if the user is the owner and the document exists, false otherwise.
 */
function isExistingOwner(userId) {
  return isOwner(userId) && resource != null;
}