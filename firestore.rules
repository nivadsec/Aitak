rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements, but only allows teachers to create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn()
     * @allow (update, delete): if isSignedIn()
     * @principle Allows public read access to announcements, but restricts writes to authenticated teachers.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    /**
     * @description Allows a teacher to read, create, update, and delete their own profile.
     * @path /teachers/{teacherId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isOwner(teacherId);
     * @principle Enforces document ownership for teacher profiles.
     */
    match /teachers/{teacherId} {
      allow get, list: if isOwner(teacherId);
      allow create: if request.auth.uid == teacherId;
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage students associated with their profile.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isOwner(teacherId);
     * @principle Enforces path-based ownership for student profiles.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage daily reports for students associated with their profile.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isOwner(teacherId);
     * @principle Enforces path-based ownership for daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage subject items for daily reports of students associated with their profile.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isOwner(teacherId);
     * @principle Enforces path-based ownership for subject items.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

      /**
     * @description Allows a teacher to create, read, update and delete messages sent to all students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isOwner(teacherId);
     * @principle Enforces path-based ownership for messages sent to all students.
     */
    match /teachers/{teacherId}/messages/{messageId} {
        allow get, list: if isOwner(teacherId);
        allow create: if isOwner(teacherId);
        allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to create, read, update and delete messages sent to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isOwner(teacherId);
     * @principle Enforces path-based ownership for messages sent to a specific student.
     */
     match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
        allow get, list: if isOwner(teacherId);
        allow create: if isOwner(teacherId);
        allow update, delete: if isOwner(teacherId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  // The following functions are not needed in prototype mode, since the data shape is flexible.
  // function isExistingOwner(userId) {
  //   return isSignedIn() && request.auth.uid == userId && resource.data.teacherId == userId;
  // }

  // function isExistingOwnerForStudent(teacherId, studentId) {
  //   return isOwner(teacherId) && resource.data.teacherId == teacherId;
  // }

  //   function isExistingOwnerForDailyReport(teacherId, studentId, dailyReportId) {
  //   return isOwner(teacherId) && resource.data.teacherId == teacherId;
  // }

  //   function isExistingOwnerForSubjectItem(teacherId, studentId, dailyReportId, subjectItemId) {
  //   return isOwner(teacherId) && resource.data.teacherId == teacherId;
  // }

  //   function isExistingOwnerForMessage(teacherId, messageId) {
  //   return isOwner(teacherId) && resource.data.teacherId == teacherId;
  // }

  //     function isExistingOwnerForStudentMessage(teacherId, studentId, messageId) {
  //   return isOwner(teacherId) && resource.data.teacherId == teacherId;
  // }
}