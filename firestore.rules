/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership and teacher-management model for the آی‌تاب application.
 *
 * Data Structure:
 * All data is organized hierarchically, with teachers managing students and their associated data.
 * - /announcements/{announcementId}: Public announcements.
 * - /teachers/{teacherId}: Teacher profiles.
 * - /teachers/{teacherId}/students/{studentId}: Student profiles managed by a teacher.
 * - /teachers/{teacherId}/students/{studentId}/...: Student-specific data (reports, messages, etc.).
 *
 * Key Security Decisions:
 * - Teachers can manage student profiles and data associated with their students.
 * - Students can only access their own data.
 * - Public announcements are readable by anyone.
 * - Listing of users is generally disallowed for privacy and security.
 *
 * Denormalization for Authorization:
 *  To simplify rules, student documents are nested under teachers, making it easy to check teacher-student relationships.
 *  For example, a recommendation document at /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId} implicitly contains both teacherId and studentId.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read public announcements. Only teachers can create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true;
     * @allow (create): if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
     * @allow (update, delete): if isSignedIn() && resource.data.teacherId == request.auth.uid;
     * @deny (create): if !isSignedIn()
     * @deny (update, delete): if !isSignedIn()
     * @principle Public read, owner-only writes.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    /**
     * @description Allows anyone to read teacher profile, but only the teacher can create, update, or delete their own profile.
     * @path /teachers/{teacherId}
     * @allow (get): if true;
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isExistingOwner(teacherId);
     * @deny (list): if true;
     * @principle Owner-only access to teacher profiles, public read access.
     */
    match /teachers/{teacherId} {
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage student profiles under their care, and students to read their own profile.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId && request.resource.data.id == studentId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn() || request.resource.data.id != studentId;
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed student profiles with owner read access.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId && request.resource.data.id == studentId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

    /**
     * @description Allows a teacher to manage daily reports for their students, and the student to read their own reports.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed daily reports with owner read access.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

    /**
     * @description Allows a teacher to manage subject items for a daily report, and the student to read data.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed subject items with owner read access.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

   /**
     * @description Allows a teacher to create messages to all students. Students can access messages directed to them.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow get: if isSignedIn() && (resource.data.studentId == 'all' || resource.data.studentId == request.auth.uid) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow list: if isSignedIn() && request.auth.uid == teacherId;
     * @allow create: if isSignedIn() && request.auth.uid == teacherId;
     * @allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny create: if !isSignedIn() || request.auth.uid != teacherId;
     * @deny update, delete: if !isSignedIn() || request.auth.uid != teacherId;
     * @principle Teacher-created messages, student read access.
     */
    match /teachers/{teacherId}/messages/{messageId} {
      allow get: if isSignedIn() && (resource.data.studentId == 'all' || resource.data.studentId == request.auth.uid) || (isSignedIn() && request.auth.uid == teacherId);
      allow list: if isSignedIn() && request.auth.uid == teacherId;
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

     /**
     * @description Allows a teacher to create and manage messages to a specific student. Students can only read messages sent to them.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow get: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow create: if isSignedIn() && request.auth.uid == teacherId;
     * @allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny create: if !isSignedIn() || request.auth.uid != teacherId;
     * @deny update, delete: if !isSignedIn() || request.auth.uid != teacherId;
     * @principle Teacher-created messages, student read access.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }
    
    /**
     * @description Allows a teacher to manage exam reports for their students, and the student to read their own reports.
     * @path /teachers/{teacherId}/students/{studentId}/examReports/{reportId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed exam reports with owner read access.
     */
    match /teachers/{teacherId}/students/{studentId}/examReports/{reportId} {
      allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

     /**
     * @description Allows a teacher to manage weekly progress reports for their students, and the student to read their own reports.
     * @path /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed weekly progress reports with owner read access.
     */
    match /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId} {
      allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

   /**
     * @description Allows a teacher to manage topic investment reports for their students, and the student to read their own reports.
     * @path /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed topic investment reports with owner read access.
     */
    match /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId} {
      allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

    /**
     * @description Allows a teacher to manage overall exam reports for their students, and the student to read their own reports.
     * @path /teachers/{teacherId}/students/{studentId}/overallExamReports/{reportId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed overall exam reports with owner read access.
     */
    match /teachers/{teacherId}/students/{studentId}/overallExamReports/{reportId} {
      allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

    /**
     * @description Allows a teacher to create recommendations for their students, and the student to read the recommendation.
     * @path /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId}
     * @allow (get): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed recommendations with owner read access.
     */
    match /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId} {
      allow get: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

     /**
     * @description Allows a teacher to manage focus intervals for their students, and the student to read their own intervals.
     * @path /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && (request.auth.uid == studentId);
     * @allow (update, delete): if isSignedIn() && (request.auth.uid == studentId) && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed focus intervals with owner access.
     */
    match /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId} {
      allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
      allow create: if isSignedIn() && (request.auth.uid == studentId);
      allow update: if isSignedIn() && (request.auth.uid == studentId) && resource != null;
      allow delete: if isSignedIn() && (request.auth.uid == studentId) && resource != null;
    }
   
   /**
     * @description Allows a teacher to create questionnaires.
     * @path /teachers/{teacherId}/questionnaires/{questionnaireId}
     * @allow (get, list): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed questionnaires.
     */
    match /teachers/{teacherId}/questionnaires/{questionnaireId} {
      allow get, list: if isSignedIn() && request.auth.uid == teacherId;
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

   /**
     * @description Allows a student to submit a questionnaire.
     * @path /teachers/{teacherId}/questionnaires/{questionnaireId}/submissions/{submissionId}
     * @allow get: if isOwner(request.resource.data.studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow list: if isOwner(request.resource.data.studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow create: if isSignedIn() && request.auth.uid == request.resource.data.studentId;
     * @allow update: if false;
     * @allow delete: if false;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed questionnaires with student submissions.
     */
    match /teachers/{teacherId}/questionnaires/{questionnaireId}/submissions/{submissionId} {
        allow get: if isOwner(request.resource.data.studentId) || (isSignedIn() && request.auth.uid == teacherId);
        allow list: if isOwner(request.resource.data.studentId) || (isSignedIn() && request.auth.uid == teacherId);
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.studentId;
        allow update: if false;
        allow delete: if false;
    }
   
   /**
     * @description Allows a teacher to create tests.
     * @path /teachers/{teacherId}/tests/{testId}
     * @allow (get, list): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed tests.
     */
    match /teachers/{teacherId}/tests/{testId} {
      allow get, list: if isSignedIn() && request.auth.uid == teacherId;
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

   /**
     * @description Allows a student to submit a test.
     * @path /teachers/{teacherId}/tests/{testId}/submissions/{submissionId}
     * @allow get: if isOwner(request.resource.data.studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow list: if isOwner(request.resource.data.studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow create: if isSignedIn() && request.auth.uid == request.resource.data.studentId;
     * @allow update: if false;
     * @allow delete: if false;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed tests with student submissions.
     */
    match /teachers/{teacherId}/tests/{testId}/submissions/{submissionId} {
        allow get: if isOwner(request.resource.data.studentId) || (isSignedIn() && request.auth.uid == teacherId);
        allow list: if isOwner(request.resource.data.studentId) || (isSignedIn() && request.auth.uid == teacherId);
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.studentId;
        allow update: if false;
        allow delete: if false;
    }

   /**
     * @description Allows a teacher to create strategic plans.
     * @path /teachers/{teacherId}/strategicPlans/{planId}
     * @allow (get, list): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed strategic plans.
     */
    match /teachers/{teacherId}/strategicPlans/{planId} {
      allow get, list: if isSignedIn() && request.auth.uid == teacherId;
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

    /**
     * @description Allows a teacher to create schedule items.
     * @path /teachers/{teacherId}/schedule/{scheduleItemId}
     * @allow (get, list): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed schedule items.
     */
    match /teachers/{teacherId}/schedule/{scheduleItemId} {
      allow get, list: if isSignedIn() && request.auth.uid == teacherId;
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

   /**
     * @description Allows a teacher to create consulting content.
     * @path /teachers/{teacherId}/consultingContent/{contentId}
     * @allow (get, list): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed consulting content.
     */
    match /teachers/{teacherId}/consultingContent/{contentId} {
      allow get, list: if isSignedIn() && request.auth.uid == teacherId;
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

    /**
     * @description Allows a teacher to log student login history.
     * @path /teachers/{teacherId}/loginHistory/{historyId}
     * @allow (get, list): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if false;
     * @deny (create): if !isSignedIn();
     * @principle Teacher-managed login history.
     */
    match /teachers/{teacherId}/loginHistory/{historyId} {
      allow get, list: if isSignedIn() && request.auth.uid == teacherId;
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update: if false;
      allow delete: if false;
    }

   /**
     * @description Allows a teacher to answer a student's question.
     * @path /teachers/{teacherId}/questions/{questionId}
     * @allow (get, list): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (create): if isSignedIn() && request.auth.uid == request.resource.data.teacherId && request.resource.data.studentId == request.auth.uid;
     * @allow (update): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @allow (delete): if false;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed question/answer.
     */
     match /teachers/{teacherId}/questions/{questionId} {
        allow get, list: if isSignedIn() && request.auth.uid == teacherId;
        allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid && request.resource.data.teacherId == teacherId;
        allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
        allow delete: if false;
    }

   /**
     * @description Allows a teacher to create a student exam checklist.
     * @path /teachers/{teacherId}/students/{studentId}/detailedExamChecklists/{checklistId}
     * @allow (get, list): if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isSignedIn() && request.auth.uid == teacherId && resource != null;
     * @deny (create): if !isSignedIn();
     * @deny (update, delete): if !isSignedIn();
     * @principle Teacher-managed exam checklist.
     */
     match /teachers/{teacherId}/students/{studentId}/detailedExamChecklists/{checklistId} {
        allow get, list: if isOwner(studentId) || (isSignedIn() && request.auth.uid == teacherId);
        allow create: if isSignedIn() && request.auth.uid == teacherId;
        allow update: if isSignedIn() && request.auth.uid == teacherId && resource != null;
        allow delete: if isSignedIn() && request.auth.uid == teacherId && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}