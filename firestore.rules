/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset enforces a hierarchical data ownership model. Teachers own students, and students own their data within the teacher/student context.
 * @data-structure Data is nested under /teachers/{teacherId}/students/{studentId}/..., reflecting the ownership model. Announcements are public.
 * @key-security-decisions
 *   - Teachers can only manage their own students and associated data.
 *   - Students can only access their own data.
 *   - Announcements are publicly readable.
 *   - Listing of documents is generally allowed for owners.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read public announcements. Teachers can create announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn() && request.resource.data.teacherId == request.auth.uid
     * @deny (update, delete): if true
     * @principle Allows public read access for announcements and restricts write access to authenticated teachers.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to read their own profile data. Teachers can create their profile.
     * @path /teachers/{teacherId}
     * @allow (get): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (list): if false
     * @deny (update, delete): if true
     * @principle Enforces document ownership for reads and restricts listing.
     */
    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow list: if false;
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to manage their own students.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of student profiles and prevents unauthorized modifications.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.id == studentId;
      allow update: if isOwner(teacherId) && resource.data.id == studentId;
      allow delete: if false;
    }

    /**
     * @description Allows students and teachers to read daily reports. Teachers can create and modify reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update): if isOwner(teacherId) && resource != null;
     * @deny (delete): if true
     * @principle Enforces teacher ownership of daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isOwner(teacherId) && resource != null;
      allow delete: if false;
    }

    /**
     * @description Allows teachers to manage subject items for a specific daily report of their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update): if isOwner(teacherId) && resource != null;
     * @deny (delete): if true
     * @principle Enforces teacher ownership of subject items.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isOwner(teacherId) && resource != null;
      allow delete: if false;
    }

    /**
     * @description Allows teachers to create messages for all their students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of messages.
     */
    match /teachers/{teacherId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to create messages for a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId);
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of student-specific messages.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

   /**
     * @description Allows teachers to create exam reports for their students. Students can read their own reports.
     * @path /teachers/{teacherId}/students/{studentId}/examReports/{reportId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of exam reports.
     */
    match /teachers/{teacherId}/students/{studentId}/examReports/{reportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to create weekly progress reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of weekly progress reports.
     */
    match /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to create topic investment reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of topic investment reports.
     */
    match /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to create recommendations for their students.
     * @path /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of recommendations.
     */
    match /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows students to record their own focus intervals.
     * @path /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces student ownership of focus intervals.
     */
    match /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to create quizzes.
     * @path /teachers/{teacherId}/quizzes/{quizId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of quizzes.
     */
    match /teachers/{teacherId}/quizzes/{quizId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to see student submissions for their quizzes. Students can only create submissions for themselves.
     * @path /teachers/{teacherId}/quizzes/{quizId}/submissions/{submissionId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId);
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of quizzes and student ownership of submissions.
     */
    match /teachers/{teacherId}/quizzes/{quizId}/submissions/{submissionId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to create strategic plans.
     * @path /teachers/{teacherId}/strategicPlans/{planId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of strategic plans.
     */
    match /teachers/{teacherId}/strategicPlans/{planId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to create schedule items.
     * @path /teachers/{teacherId}/schedule/{scheduleItemId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of schedule items.
     */
    match /teachers/{teacherId}/schedule/{scheduleItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows teachers to create consulting content.
     * @path /teachers/{teacherId}/consultingContent/{contentId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @deny (update, delete): if true
     * @principle Enforces teacher ownership of consulting content.
     */
    match /teachers/{teacherId}/consultingContent/{contentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}