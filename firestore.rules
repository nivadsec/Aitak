rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements, but only teachers can create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn()
     * @allow (update): if isSignedIn()
     * @allow (delete): if isSignedIn()
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn()
     * @deny (delete): if !isSignedIn()
     * @principle Allows public read access while restricting write access to authenticated users (teachers).
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows a teacher to read, create, update, and delete their own profile.
     * @path /teachers/{teacherId}
     * @allow (get): if isOwner(teacherId)
     * @allow (list): if false
     * @allow (create): if isOwner(teacherId)
     * @allow (update): if isExistingOwner(teacherId)
     * @allow (delete): if isExistingOwner(teacherId)
     * @deny (create): if !isOwner(teacherId)
     * @deny (update): if !isExistingOwner(teacherId)
     * @deny (delete): if !isExistingOwner(teacherId)
     * @principle Enforces document ownership for all operations.
     */
    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId);
      allow list: if false;
      allow create: if request.auth.uid == teacherId;
      allow update: if isOwner(teacherId);
      allow delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to read, create, update, and delete student profiles under their control.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get): if isTeacherManagingStudent(teacherId, studentId)
     * @allow (list): if isOwner(teacherId)
     * @allow (create): if isTeacherManagingStudent(teacherId, studentId)
     * @allow (update): if isExistingTeacherManagingStudent(teacherId, studentId)
     * @allow (delete): if isExistingTeacherManagingStudent(teacherId, studentId)
     * @deny (create): if !isTeacherManagingStudent(teacherId, studentId)
     * @deny (update): if !isExistingTeacherManagingStudent(teacherId, studentId)
     * @deny (delete): if !isExistingTeacherManagingStudent(teacherId, studentId)
     * @principle Enforces teacher ownership of student profiles.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get: if isTeacherManagingStudent(teacherId, studentId);
      allow list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isOwner(teacherId);
      allow delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to read, create, update, and delete daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get): if isTeacherManagingStudent(teacherId, studentId)
     * @allow (list): if isTeacherManagingStudent(teacherId, studentId)
     * @allow (create): if isTeacherManagingStudent(teacherId, studentId);
     * @allow (update): if isExistingTeacherManagingStudent(teacherId, studentId)
     * @allow (delete): if isExistingTeacherManagingStudent(teacherId, studentId)
     * @deny (create): if !isTeacherManagingStudent(teacherId, studentId)
     * @deny (update): if !isExistingTeacherManagingStudent(teacherId, studentId)
     * @deny (delete): if !isExistingTeacherManagingStudent(teacherId, studentId)
     * @principle Enforces teacher ownership of student daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get: if isTeacherManagingStudent(teacherId, studentId);
      allow list: if isTeacherManagingStudent(teacherId, studentId);
      allow create: if isOwner(teacherId);
      allow update: if isOwner(teacherId);
      allow delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to read, create, update, and delete subject items for a student's daily report.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get): if isTeacherManagingStudent(teacherId, studentId)
     * @allow (list): if isTeacherManagingStudent(teacherId, studentId)
     * @allow (create): if isTeacherManagingStudent(teacherId, studentId)
     * @allow (update): if isExistingTeacherManagingStudent(teacherId, studentId)
     * @allow (delete): if isExistingTeacherManagingStudent(teacherId, studentId)
     * @deny (create): if !isTeacherManagingStudent(teacherId, studentId)
     * @deny (update): if !isExistingTeacherManagingStudent(teacherId, studentId)
     * @deny (delete): if !isExistingTeacherManagingStudent(teacherId, studentId)
     * @principle Enforces teacher ownership of student subject items within daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get: if isTeacherManagingStudent(teacherId, studentId);
      allow list: if isTeacherManagingStudent(teacherId, studentId);
      allow create: if isOwner(teacherId);
      allow update: if isOwner(teacherId);
      allow delete: if isOwner(teacherId);
    }
    
    /**
     * @description Allows a teacher to read, create, update, and delete messages sent to all students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get): if isOwner(teacherId);
     * @allow (list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update): if isExistingOwner(teacherId) && resource.data.teacherId == request.auth.uid;
     * @allow (delete): if isExistingOwner(teacherId) && resource.data.teacherId == request.auth.uid;
     * @deny (create): if !isOwner(teacherId);
     * @deny (update): if !isExistingOwner(teacherId);
     * @deny (delete): if !isExistingOwner(teacherId);
     * @principle Enforces teacher ownership of messages sent to all students.
     */
     match /teachers/{teacherId}/messages/{messageId} {
        allow get: if isOwner(teacherId);
        allow list: if isOwner(teacherId);
        allow create: if isOwner(teacherId);
        allow update: if isOwner(teacherId);
        allow delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to read, create, update, and delete messages sent to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get): if isTeacherManagingStudent(teacherId, studentId);
     * @allow (list): if isTeacherManagingStudent(teacherId, studentId);
     * @allow (create): if isTeacherManagingStudent(teacherId, studentId);
     * @allow (update): if isExistingTeacherManagingStudent(teacherId, studentId) && resource.data.teacherId == request.auth.uid;
     * @allow (delete): if isExistingTeacherManagingStudent(teacherId, studentId) && resource.data.teacherId == request.auth.uid;
     * @deny (create): if !isTeacherManagingStudent(teacherId, studentId);
     * @deny (update): if !isExistingTeacherManagingStudent(teacherId, studentId);
     * @deny (delete): if !isExistingTeacherManagingStudent(teacherId, studentId);
     * @principle Enforces teacher ownership of messages sent to a specific student.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
        allow get: if isTeacherManagingStudent(teacherId, studentId);
        allow list: if isTeacherManagingStudent(teacherId, studentId);
        allow create: if isOwner(teacherId);
        allow update: if isOwner(teacherId);
        allow delete: if isOwner(teacherId);
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource, based on the provided userId.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource, and if the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(resource);
    }

    /**
     * @description Checks if the authenticated user (teacher) manages the student.
     * @param {string} teacherId The teacher's user ID.
     * @param {string} studentId The student's user ID.
     * @return {boolean} True if the teacher manages the student, false otherwise.
     */
    function isTeacherManagingStudent(teacherId, studentId) {
      return request.auth.uid == teacherId;
    }

    /**
     * @description Checks if the authenticated user (teacher) manages the student and if the resource exists.
     * @param {string} teacherId The teacher's user ID.
     * @param {string} studentId The student's user ID.
     * @return {boolean} True if the teacher manages the student and the resource exists, false otherwise.
     */
    function isExistingTeacherManagingStudent(teacherId, studentId) {
      return isTeacherManagingStudent(teacherId, studentId) && exists(resource);
    }
  }
}