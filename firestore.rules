rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read public announcements. Teachers can create, update, and delete announcements.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true;
     * @allow (create): if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
     * @allow (update, delete): if isSignedIn() && resource.data.teacherId == request.auth.uid;
     * @deny (create): if request.resource.data.teacherId != request.auth.uid;
     * @principle Public read access with teacher-only writes, enforces teacher ownership for writes.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.teacherId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.teacherId;
    }

    /**
     * @description Allows access to teacher profiles. Teachers can only create their own profile.
     * @path /teachers/{teacherId}
     * @allow (get, list): if false;
     * @allow (create): if isSignedIn() && request.auth.uid == teacherId;
     * @allow (update, delete): if isExistingOwner(teacherId);
     * @deny (create): if request.auth.uid != teacherId;
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /teachers/{teacherId} {
      allow get, list: if false;
      allow create: if isSignedIn() && request.auth.uid == teacherId;
      allow update, delete: if isSignedIn() && request.auth.uid == teacherId;
    }

    /**
     * @description Allows teachers to manage their students' profiles. Students can only read their own profile data.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.id == studentId;
     * @allow (update, delete): if isExistingOwner(teacherId) && request.resource.data.id == studentId;
     * @deny (create): if request.resource.data.id != studentId;
     * @principle Enforces teacher ownership for student management, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers and students to manage daily reports.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Allows teachers and students to manage subject items within daily reports.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.dailyReportId == dailyReportId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.dailyReportId == dailyReportId;
     * @deny (create): if request.resource.data.dailyReportId != dailyReportId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

     /**
      * @description Allows teachers to create messages to all students. Messages can be created for 'all' students. Students can only access messages directed specifically to them
      * @path /teachers/{teacherId}/messages/{messageId}
      * @allow (get, list): if false;
      * @allow (create): if isOwner(teacherId);
      * @allow (update, delete): if isExistingOwner(teacherId);
      * @principle Enforces teacher ownership for student messages
      */
    match /teachers/{teacherId}/messages/{messageId} {
      allow get, list: if false;
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

     /**
      * @description Allows teachers to create messages to specific students. Students can only access messages directed specifically to them
      * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
      * @allow (get): if isOwner(teacherId) || isOwner(studentId);
      * @allow (list): if isOwner(teacherId) || isOwner(studentId);
      * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId;
      * @allow (update, delete): if isExistingOwner(teacherId) && request.resource.data.studentId == studentId;
      * @deny (create): if request.resource.data.studentId != studentId;
      * @principle Enforces teacher ownership for student messages, validates relational integrity between documents.
      */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get: if isOwner(teacherId) || request.auth.uid == studentId;
      allow list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers and students to manage exam reports.
     * @path /teachers/{teacherId}/students/{studentId}/examReports/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/examReports/{reportId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Allows teachers and students to manage weekly progress reports.
     * @path /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Allows teachers and students to manage topic investment reports.
     * @path /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Allows teachers and students to manage overall exam reports.
     * @path /teachers/{teacherId}/students/{studentId}/overallExamReports/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/overallExamReports/{reportId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Allows teachers to create recommendations for their students.  Students can only access recommendations directed specifically to them.
     * @path /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
     * @allow (update, delete): if isExistingOwner(teacherId) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
     * @deny (create): if request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId;
     * @principle Enforces teacher ownership for recommendations, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers and students to manage focus intervals.
     * @path /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Allows teachers to manage questionnaires.
     * @path /teachers/{teacherId}/questionnaires/{questionnaireId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isExistingOwner(teacherId);
     * @principle Enforces teacher ownership for questionnaires.
     */
    match /teachers/{teacherId}/questionnaires/{questionnaireId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers and students to manage questionnaire submissions.
     * @path /teachers/{teacherId}/questionnaires/{questionnaireId}/submissions/{submissionId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/questionnaires/{questionnaireId}/submissions/{submissionId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Allows teachers to manage tests.
     * @path /teachers/{teacherId}/tests/{testId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isExistingOwner(teacherId);
     * @principle Enforces teacher ownership for tests.
     */
    match /teachers/{teacherId}/tests/{testId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers and students to manage test submissions.
     * @path /teachers/{teacherId}/tests/{testId}/submissions/{submissionId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/tests/{testId}/submissions/{submissionId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Allows teachers to manage strategic plans.
     * @path /teachers/{teacherId}/strategicPlans/{planId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isExistingOwner(teacherId);
     * @principle Enforces teacher ownership for strategic plans.
     */
    match /teachers/{teacherId}/strategicPlans/{planId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers to manage schedule items.
     * @path /teachers/{teacherId}/schedule/{scheduleItemId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isExistingOwner(teacherId);
     * @principle Enforces teacher ownership for schedule items.
     */
    match /teachers/{teacherId}/schedule/{scheduleItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers to manage consulting content.
     * @path /teachers/{teacherId}/consultingContent/{contentId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if isExistingOwner(teacherId);
     * @principle Enforces teacher ownership for consulting content.
     */
    match /teachers/{teacherId}/consultingContent/{contentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers to create login history records for their students.
     * @path /teachers/{teacherId}/loginHistory/{historyId}
     * @allow (get, list): if false;
     * @allow (create): if isOwner(teacherId);
     * @allow (update, delete): if false; // Login history records are append-only
     * @principle Enforces teacher ownership for login history, restricts access to login attempts.
     */
    match /teachers/{teacherId}/loginHistory/{historyId} {
      allow get, list: if false;
      allow create: if isOwner(teacherId);
      allow update, delete: if false; // Login history records are append-only
    }

    /**
     * @description Allows teachers to manage questions asked by students.
     * @path /teachers/{teacherId}/questions/{questionId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (update, delete): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @principle Enforces teacher ownership for questions asked by students.
     */
    match /teachers/{teacherId}/questions/{questionId} {
        allow get, list: if isOwner(teacherId);
        allow create: if isOwner(teacherId);
        allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows teachers and students to manage detailed exam checklists.
     * @path /teachers/{teacherId}/students/{studentId}/detailedExamChecklists/{checklistId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) || (isOwner(studentId) && request.resource.data.studentId == studentId);
     * @allow (update, delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if request.resource.data.studentId != studentId;
     * @principle Enforces teacher or student ownership, validates relational integrity between documents.
     */
    match /teachers/{teacherId}/students/{studentId}/detailedExamChecklists/{checklistId} {
      allow get, list: if isOwner(teacherId) || request.auth.uid == studentId;
      allow create: if isOwner(teacherId) || (request.auth.uid == studentId);
      allow update, delete: if isOwner(teacherId) || (request.auth.uid == studentId);
    }

    /**
     * @description Defines helper functions used in the rules.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && resource.data.teacherId == request.auth.uid;
    }
  }
}