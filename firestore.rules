/**
 * @fileoverview Firestore Security Rules for the آی‌تاب system.
 *
 * Core Philosophy:
 * This ruleset enforces a strict teacher-ownership model for student data. Teachers can only
 * manage data related to their own students. Public announcements are readable by all.
 *
 * Data Structure:
 * - /announcements/{announcementId}: Public announcements, readable by everyone.
 * - /teachers/{teacherId}: Teacher profiles, where teacherId is the Firebase Auth UID.
 * - /teachers/{teacherId}/students/{studentId}: Student profiles managed by a teacher.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}: Daily reports for a student.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}: Subject items for a daily report.
 * - /teachers/{teacherId}/messages/{messageId}: Messages sent by a teacher to all students.
 * - /teachers/{teacherId}/students/{studentId}/messages/{messageId}: Messages sent by a teacher to a specific student.
 *
 * Key Security Decisions:
 * - Teachers can only manage their own profiles.
 * - Teachers can only manage student data under their teacher ID.
 * - Students cannot directly access or modify student or teacher data.
 * - Announcements are publicly readable.
 * - No user listing is allowed (for teachers or students).
 *
 * Denormalization for Authorization:
 * The data structure includes denormalized 'teacherId' and 'studentId' fields in nested
 * documents to ensure authorization independence. This avoids the need for costly and
 * complex `get()` operations to check parent document ownership.
 *
 * Structural Segregation:
 * The system uses structural segregation by nesting student data under teacher profiles. This ensures
 * that teachers can only access and manage students assigned to them. The separate /announcements
 * collection ensures that public announcements are managed separately from private user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements, but only allows teachers to create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn() && request.resource.data.teacherId == request.auth.uid
     * @allow (update): if isSignedIn() && resource.data.teacherId == request.auth.uid
     * @allow (delete): if isSignedIn() && resource.data.teacherId == request.auth.uid
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn() || resource.data.teacherId != request.auth.uid
     * @deny (delete): if !isSignedIn() || resource.data.teacherId != request.auth.uid
     * @principle Allows public reading of announcements and restricts write access to authorized teachers only.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.teacherId;
      allow update: if isSignedIn() && isExistingOwner(resource.data.teacherId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.teacherId);
    }

    /**
     * @description Allows a teacher to manage their own profile.
     * @path /teachers/{teacherId}
     * @allow (get): if isOwner(teacherId)
     * @allow (list): if false;
     * @allow (create): if isOwner(teacherId)
     * @allow (update): if isExistingOwner(teacherId)
     * @allow (delete): if isExistingOwner(teacherId)
     * @deny (create): if !isOwner(teacherId)
     * @deny (update): if !isOwner(teacherId)
     * @deny (delete): if !isOwner(teacherId)
     * @principle Enforces document ownership for teacher profiles.
     */
    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId);
      allow list: if false;
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage their students.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get): if isOwner(teacherId)
     * @allow (list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update): if isExistingOwner(teacherId)
     * @allow (delete): if isExistingOwner(teacherId);
     * @deny (create): if !isOwner(teacherId)
     * @deny (update): if !isOwner(teacherId)
     * @deny (delete): if !isOwner(teacherId)
     * @principle Enforces teacher-ownership for student profiles.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get: if isOwner(teacherId);
      allow list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get): if isOwner(teacherId)
     * @allow (list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update): if isExistingOwner(teacherId)
     * @allow (delete): if isExistingOwner(teacherId);
     * @deny (create): if !isOwner(teacherId)
     * @deny (update): if !isOwner(teacherId)
     * @deny (delete): if !isOwner(teacherId)
     * @principle Enforces teacher-ownership for daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get: if isOwner(teacherId);
      allow list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage subject items for daily reports of their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get): if isOwner(teacherId)
     * @allow (list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update): if isExistingOwner(teacherId);
     * @allow (delete): if isExistingOwner(teacherId);
     * @deny (create): if !isOwner(teacherId)
     * @deny (update): if !isOwner(teacherId)
     * @deny (delete): if !isOwner(teacherId)
     * @principle Enforces teacher-ownership for subject items.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get: if isOwner(teacherId);
      allow list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }
    /**
     * @description Allows a teacher to manage messages to their students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get): if isOwner(teacherId)
     * @allow (list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update): if isExistingOwner(teacherId);
     * @allow (delete): if isExistingOwner(teacherId);
     * @deny (create): if !isOwner(teacherId)
     * @deny (update): if !isOwner(teacherId)
     * @deny (delete): if !isOwner(teacherId)
     * @principle Enforces teacher-ownership for subject items.
     */
       match /teachers/{teacherId}/messages/{messageId} {
          allow get: if isOwner(teacherId);
          allow list: if isOwner(teacherId);
          allow create: if isOwner(teacherId);
          allow update: if isExistingOwner(teacherId);
          allow delete: if isExistingOwner(teacherId);
       }

      /**
       * @description Allows a teacher to manage messages to a specific student.
       * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
       * @allow (get): if isOwner(teacherId)
       * @allow (list): if isOwner(teacherId)
       * @allow (create): if isOwner(teacherId)
       * @allow (update): if isExistingOwner(teacherId);
       * @allow (delete): if isExistingOwner(teacherId);
       * @deny (create): if !isOwner(teacherId)
       * @deny (update): if !isOwner(teacherId)
       * @deny (delete): if !isOwner(teacherId)
       * @principle Enforces teacher-ownership for subject items.
       */
       match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
          allow get: if isOwner(teacherId);
          allow list: if isOwner(teacherId);
          allow create: if isOwner(teacherId);
          allow update: if isExistingOwner(teacherId);
          allow delete: if isExistingOwner(teacherId);
       }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
}