/**
 * @fileOverview Firestore Security Rules for آی‌تاب system.
 *
 * Core Philosophy:
 * This ruleset enforces a hierarchical, teacher-centric data model. Teachers can manage their own profiles, students, and related data (daily reports, subject items, and messages).
 *
 * Data Structure:
 * - /announcements/{announcementId}: Public announcements.
 * - /teachers/{teacherId}: Teacher profiles (teacherId is the Firebase Auth UID).
 * - /teachers/{teacherId}/students/{studentId}: Student profiles managed by a teacher.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}: Daily reports for a student.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}: Subject items within a daily report.
 * - /teachers/{teacherId}/messages/{messageId}: Messages sent by a teacher to all students
 * - /teachers/{teacherId}/students/{studentId}/messages/{messageId}: Messages sent by a teacher to a specific student
 *
 * Key Security Decisions:
 * - Teachers can only manage their own profiles (ownership model).
 * - Teachers can manage students and related data under their teacher ID (path-based access control).
 * - Public announcements are readable by anyone.
 * - Data validation is relaxed to allow rapid prototyping, focusing on authorization.
 * - List operations are generally allowed for owners within their data tree.
 *
 * Denormalization for Authorization:
 *  - The `teacherId` is part of the path for students, dailyReports, subjectItems, and messages to avoid needing to read the parent document for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements, but only teachers can create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn() && request.resource.data.teacherId == request.auth.uid
     * @allow (update, delete): if isSignedIn() && resource.data.teacherId == request.auth.uid
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn() || resource.data.teacherId != request.auth.uid
     * @deny (delete): if !isSignedIn() || resource.data.teacherId != request.auth.uid
     * @principle Allows public read access to announcements while restricting write access to teachers only.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.teacherId);
      allow delete: if isExistingOwner(resource.data.teacherId);
    }

    /**
     * @description Allows a teacher to read, create, update, and delete their own profile.
     * @path /teachers/{teacherId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create): if !isSelfCreate(teacherId)
     * @deny (update): if !isExistingOwner(teacherId)
     * @deny (delete): if !isExistingOwner(teacherId)
     * @principle Enforces document ownership: only the teacher can manage their own profile.
     */
    match /teachers/{teacherId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isSelfCreate(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage students under their teacher ID.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create): if request.resource.data.teacherId != teacherId
     * @deny (update): if resource.data.teacherId != teacherId
     * @deny (delete): if resource.data.teacherId != teacherId
     * @principle Enforces path-based ownership: a teacher can only manage students under their own teacher ID.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.id == studentId && request.resource.data.teacherId == teacherId;
      allow update: if isExistingOwner(teacherId) && resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to manage daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create): if request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId
     * @deny (update): if resource.data.studentId != studentId || resource.data.teacherId != teacherId
     * @deny (delete): if resource.data.studentId != studentId || resource.data.teacherId != teacherId
     * @principle Enforces path-based ownership: a teacher can only manage daily reports for students under their own teacher ID.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
      allow update: if isExistingOwner(teacherId) && resource.data.studentId == studentId && resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && resource.data.studentId == studentId && resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to manage subject items for their students' daily reports.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create): if request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId || request.resource.data.dailyReportId != dailyReportId
     * @deny (update): if resource.data.studentId != studentId || resource.data.teacherId != teacherId || resource.data.dailyReportId != dailyReportId
     * @deny (delete): if resource.data.studentId != studentId || resource.data.teacherId != teacherId || resource.data.dailyReportId != dailyReportId
     * @principle Enforces path-based ownership: a teacher can only manage subject items for students under their own teacher ID.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId && request.resource.data.dailyReportId == dailyReportId;
      allow update: if isExistingOwner(teacherId) && resource.data.studentId == studentId && resource.data.teacherId == teacherId && resource.data.dailyReportId == dailyReportId;
      allow delete: if isExistingOwner(teacherId) && resource.data.studentId == studentId && resource.data.teacherId == teacherId && resource.data.dailyReportId == dailyReportId;
    }

    /**
     * @description Allows a teacher to send messages to all of their students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId
     * @allow (update, delete): if isOwner(teacherId) && resource.data.teacherId == teacherId
     * @deny (create): if request.resource.data.teacherId != teacherId
     * @deny (update): if resource.data.teacherId != teacherId
     * @deny (delete): if resource.data.teacherId != teacherId
     * @principle Enforces path-based ownership: a teacher can only manage messages under their own teacher ID.
     */
     match /teachers/{teacherId}/messages/{messageId} {
        allow get, list: if isOwner(teacherId);
        allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
        allow update: if isExistingOwner(teacherId) && resource.data.teacherId == teacherId;
        allow delete: if isExistingOwner(teacherId) && resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to send messages to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId && request.resource.data.studentId == studentId
     * @allow (update, delete): if isOwner(teacherId) && resource.data.teacherId == teacherId && resource.data.studentId == studentId
     * @deny (create): if request.resource.data.teacherId != teacherId || request.resource.data.studentId != studentId
     * @deny (update): if resource.data.teacherId != teacherId || resource.data.studentId != studentId
     * @deny (delete): if resource.data.teacherId != teacherId || resource.data.studentId != studentId
     * @principle Enforces path-based ownership: a teacher can only manage messages under their own teacher ID and for the specified student.
     */
     match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
        allow get, list: if isOwner(teacherId);
        allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId && request.resource.data.studentId == studentId;
        allow update: if isExistingOwner(teacherId) && resource.data.teacherId == teacherId && resource.data.studentId == studentId;
        allow delete: if isExistingOwner(teacherId) && resource.data.teacherId == teacherId && resource.data.studentId == studentId;
    }


    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID AND the document already exists.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the resource ID for create operations.
     * @param {string} resourceId The resource ID to check against.
     * @return {boolean} True if the user is creating their own resource, false otherwise.
     */
     function isSelfCreate(resourceId) {
       return isSignedIn() && request.auth.uid == resourceId;
     }
  }
}