/**
 * @file Firebase Security Rules for آی‌تاب System
 * @core_philosophy This ruleset enforces a strict ownership and role-based access control model.
 *  Teachers have broad access to data related to their students. Students have access to their own data.
 *  Unauthenticated access is generally denied, except for listing public announcements.
 * @data_structure Data is organized hierarchically under collections for teachers, students, and related entities.
 *  Data for students is generally nested under the teacher's document to reflect the teacher-student relationship.
 * @key_security_decisions Teachers can manage their students profiles and student-specific data (reports, recommendations, etc.).
 *  Students can only access their own data. Public announcements are readable by everyone.
 * @denormalization Not explicitly used in this version, but consider denormalizing teacherId into student documents for direct ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read public announcements, but only teachers can create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn() && request.resource.data.teacherId == request.auth.uid
     * @allow (update, delete): if isSignedIn() && resource.data.teacherId == request.auth.uid
     * @deny (create): if !isSignedIn()
     * @deny (update, delete): if !isSignedIn() || resource.data.teacherId != request.auth.uid
     * @principle Public read, owner-only write.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    /**
     * @description Allows anyone to read a teacher's profile, but only the teacher can create, update, or delete it.
     * @path /teachers/{teacherId}
     * @allow (get, list): if true
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Owner-only access.
     */
    match /teachers/{teacherId} {
      allow get, list: if true;
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage their students' profiles.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage subject items for a specific daily report of their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

     /**
      * @description Allows a teacher to send messages to all of their students. Students cannot list these messages directly.
      * @path /teachers/{teacherId}/messages/{messageId}
      * @allow (get, list): if isOwner(teacherId)
      * @allow (create): if isOwner(teacherId)
      * @allow (update, delete): if isOwner(teacherId)
      * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
      * @principle Teacher-only access to messages sent to all students.
      */
    match /teachers/{teacherId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to send messages to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || (request.auth.uid != teacherId && request.auth.uid != studentId)
     * @principle Shared access: teacher and student.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId) || (isSignedIn() && request.auth.uid == studentId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage exam reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/examReports/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || (request.auth.uid != teacherId && request.auth.uid != studentId)
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/students/{studentId}/examReports/{reportId} {
      allow get, list: if isOwner(teacherId) || (isSignedIn() && request.auth.uid == studentId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage weekly progress reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || (request.auth.uid != teacherId && request.auth.uid != studentId)
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId} {
      allow get, list: if isOwner(teacherId) || (isSignedIn() && request.auth.uid == studentId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage topic-based time investment plans for their students.
     * @path /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || (request.auth.uid != teacherId && request.auth.uid != studentId)
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId} {
      allow get, list: if isOwner(teacherId) || (isSignedIn() && request.auth.uid == studentId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }
   /**
     * @description Allows a teacher to manage overall exam reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/overallExamReports/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || (request.auth.uid != teacherId && request.auth.uid != studentId)
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/students/{studentId}/overallExamReports/{reportId} {
      allow get, list: if isOwner(teacherId) || (isSignedIn() && request.auth.uid == studentId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to send recommendations to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || (request.auth.uid != teacherId && request.auth.uid != studentId)
     * @principle Shared access: teacher and student.
     */
    match /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId} {
      allow get, list: if isOwner(teacherId) || (isSignedIn() && request.auth.uid == studentId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a student to record their focus intervals.
     * @path /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId)
     * @allow (create): if isOwner(studentId);
     * @allow (update, delete): if isOwner(studentId);
     * @deny (create, update, delete): if !isSignedIn() || (request.auth.uid != teacherId && request.auth.uid != studentId)
     * @principle Shared access: teacher and student. Student-created content.
     */
    match /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId} {
      allow get, list: if isOwner(teacherId) || (isSignedIn() && request.auth.uid == studentId);
      allow create: if isSignedIn() && request.auth.uid == studentId;
      allow update, delete: if isSignedIn() && request.auth.uid == studentId;
    }

    /**
     * @description Allows a teacher to create quizzes.
     * @path /teachers/{teacherId}/quizzes/{quizId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/quizzes/{quizId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to view quiz submissions and students to submit quizzes.
     * @path /teachers/{teacherId}/quizzes/{quizId}/submissions/{submissionId}
     * @allow (get, list): if isOwner(teacherId) || get(/databases/$(database)/documents/teachers/$(teacherId)/students/$(request.auth.uid)).data.id == request.auth.uid;
     * @allow (create): if isSignedIn() && get(/databases/$(database)/documents/teachers/$(teacherId)/students/$(request.auth.uid)).data.id == request.auth.uid;
     * @allow (update, delete): if false;
     */
    match /teachers/{teacherId}/quizzes/{quizId}/submissions/{submissionId} {
      allow get, list: if isOwner(teacherId) || (isSignedIn() && isStudentOfTeacher(teacherId));
      allow create: if isSignedIn() && isStudentOfTeacher(teacherId);
      allow update, delete: if false;
    }

    /**
     * @description Allows a teacher to manage strategic plans.
     * @path /teachers/{teacherId}/strategicPlans/{planId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/strategicPlans/{planId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage schedule items.
     * @path /teachers/{teacherId}/schedule/{scheduleItemId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/schedule/{scheduleItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage consulting content.
     * @path /teachers/{teacherId}/consultingContent/{contentId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isOwner(teacherId)
     * @allow (update, delete): if isOwner(teacherId)
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Owner-only access.
     */
    match /teachers/{teacherId}/consultingContent/{contentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to view login history for their students.
     * @path /teachers/{teacherId}/loginHistory/{historyId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if false;
     * @allow (update, delete): if false;
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Teacher-only access.
     */
    match /teachers/{teacherId}/loginHistory/{historyId} {
      allow get, list: if isOwner(teacherId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    /**
     * @description Allows a teacher to view questions from their students.
     * @path /teachers/{teacherId}/questions/{questionId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isStudentOfTeacher(teacherId) && request.resource.data.studentId == request.auth.uid;
     * @allow (update): if isOwner(teacherId);
     * @allow (delete): if false;
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Teacher-only access.
     */
    match /teachers/{teacherId}/questions/{questionId} {
        allow get, list: if isOwner(teacherId);
        allow create: if isSignedIn() && isStudentOfTeacher(teacherId) && request.resource.data.studentId == request.auth.uid;
        allow update: if isOwner(teacherId);
        allow delete: if false;
    }
    /**
     * @description Allows a teacher to view questions from their students.
     * @path /teachers/{teacherId}/students/{studentId}/questions/{questionId}
     * @allow (get, list): if isOwner(teacherId)
     * @allow (create): if isStudentOfTeacher(teacherId);
     * @allow (update): if isOwner(teacherId);
     * @allow (delete): if false;
     * @deny (create, update, delete): if !isSignedIn() || request.auth.uid != teacherId
     * @principle Teacher-only access.
     */
    match /teachers/{teacherId}/students/{studentId}/questions/{questionId} {
        allow get, list: if isOwner(teacherId);
        allow create: if isSignedIn() && isStudentOfTeacher(teacherId) && request.auth.uid == studentId;
        allow update: if isOwner(teacherId);
        allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isSignedIn() && request.auth.uid == userId && resource != null;
  }
    function isStudentOfTeacher(teacherId) {
      return exists(/databases/$(database)/documents/teachers/$(teacherId)/students/$(request.auth.uid));
    }
}