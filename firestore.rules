/**
 * @description This ruleset enforces a strict, hierarchical ownership model. Teachers manage students,
 *              and students own their data within the teacher's scope. Public announcements are readable by all.
 * @dataStructure
 *   - /announcements/{announcementId}: Public announcements.
 *   - /teachers/{teacherId}: Teacher profiles.
 *   - /teachers/{teacherId}/students/{studentId}: Student profiles managed by a teacher.
 *   - /teachers/{teacherId}/students/{studentId}/...: Student-specific data (daily reports, messages, etc.).
 * @keySecurityDecisions
 *   - Teachers can only manage data within their own /teachers/{teacherId} path.
 *   - Students can only read/write data within their own /teachers/{teacherId}/students/{studentId} path.
 *   - Announcements are publicly readable, but only teachers can create them.
 *   - Listing of teachers is disallowed.
 * @denormalizationForAuthorization N/A (using path-based authorization)
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements. Only teachers can create, update or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
     * @allow (update, delete): if isSignedIn() && resource.data.teacherId == request.auth.uid;
     * @deny (create): if !isSignedIn() || request.resource.data.teacherId != request.auth.uid;
     * @deny (update, delete): if !isSignedIn() || resource.data.teacherId != request.auth.uid;
     * @principle Allows public read access to announcements, but restricts write access to the creating teacher.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    /**
     * @description Disallows listing of all teachers. Only allows getting a specific teacher by ID.
     * @path /teachers/{teacherId}
     * @allow (get): if true;
     * @deny (list): if true;
     * @allow (create): if false;
     * @allow (update): if false;
     * @allow (delete): if false;
     * @principle Prevents unauthorized listing of teacher profiles.
     */
    match /teachers/{teacherId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows a teacher to manage student profiles assigned to them.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.auth.uid == teacherId;
     * @allow (update): if isExistingOwner(teacherId) && request.auth.uid == teacherId;
     * @allow (delete): if isExistingOwner(teacherId) && request.auth.uid == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.auth.uid != teacherId;
     * @deny (update): if !isExistingOwner(teacherId) || request.auth.uid != teacherId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.auth.uid != teacherId;
     * @principle Enforces teacher ownership for student profile management.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.auth.uid == teacherId;
      allow update: if isExistingOwner(teacherId) && request.auth.uid == teacherId;
      allow delete: if isExistingOwner(teacherId) && request.auth.uid == teacherId;
    }

    /**
     * @description Allows a teacher to manage daily reports for their students. Students can list their own reports.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get): if isOwner(teacherId) || isOwner(studentId);
     * @allow (list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @principle Teachers manage student data, and students can access their own data.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get: if isOwner(teacherId) || isOwner(studentId);
      allow list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
    }

    /**
     * @description Allows a teacher to manage subject items for a student's daily report.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.dailyReportId == dailyReportId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.dailyReportId == dailyReportId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.dailyReportId == dailyReportId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.dailyReportId != dailyReportId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.dailyReportId != dailyReportId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.dailyReportId != dailyReportId;
     * @principle Teachers manage student data.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.dailyReportId == dailyReportId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.dailyReportId == dailyReportId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.dailyReportId == dailyReportId;
    }

    /**
     * @description Allows a teacher to send messages to all of their students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId && request.resource.data.studentId == 'all';
     * @allow (update): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.teacherId != teacherId || request.resource.data.studentId != 'all';
     * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @principle Teachers manage their own messages to all students.
     */
    match /teachers/{teacherId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId && request.resource.data.studentId == 'all';
      allow update: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to send messages to a specific student. Students can list messages intended for them.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get): if isOwner(teacherId) || isOwner(studentId);
     * @allow (list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId;
     * @principle Teacher can manage data about the student and student can access their data.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get: if isOwner(teacherId) || isOwner(studentId);
      allow list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to manage exam reports for a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/examReports/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @principle Teachers manage student data.
     */
    match /teachers/{teacherId}/students/{studentId}/examReports/{reportId} {
      allow get, list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
    }

    /**
     * @description Allows a teacher to manage weekly progress reports for a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @principle Teachers manage student data.
     */
    match /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId} {
      allow get, list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
    }

    /**
     * @description Allows a teacher to manage topic investment reports for a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @principle Teachers manage student data.
     */
    match /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId} {
      allow get, list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
    }
    
       /**
     * @description Allows a teacher to manage overall exam reports for a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/overallExamReports/{reportId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @principle Teachers manage student data.
     */
    match /teachers/{teacherId}/students/{studentId}/overallExamReports/{reportId} {
      allow get, list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
    }

    /**
     * @description Allows a teacher to send recommendations to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId || request.resource.data.teacherId != teacherId;
     * @principle Teacher can manage data about the student and student can access their data.
     */
    match /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId} {
      allow get, list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId && request.resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to view focus intervals for a student. Students can list their own focus intervals.
     * @path /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId}
     * @allow (get): if isOwner(teacherId) || isOwner(studentId);
     * @allow (list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @principle Teachers manage student data, and students can access their own data.
     */
    match /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId} {
      allow get: if isOwner(teacherId) || isOwner(studentId);
      allow list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
    }

    /**
     * @description Allows a teacher to manage questionnaires.
     * @path /teachers/{teacherId}/questionnaires/{questionnaireId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (update): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @principle Teacher ownership for questionnaires.
     */
    match /teachers/{teacherId}/questionnaires/{questionnaireId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow update: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to manage questionnaire submissions for their questionnaires.
     * @path /teachers/{teacherId}/questionnaires/{questionnaireId}/submissions/{submissionId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.questionnaireId == questionnaireId;
     * @allow (update): if isExistingOwner(teacherId) && request.resource.data.questionnaireId == questionnaireId;
     * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.questionnaireId == questionnaireId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.questionnaireId != questionnaireId;
     * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.questionnaireId != questionnaireId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.questionnaireId != questionnaireId;
     * @principle Teacher ownership for questionnaire submissions.
     */
    match /teachers/{teacherId}/questionnaires/{questionnaireId}/submissions/{submissionId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.questionnaireId == questionnaireId;
      allow update: if isExistingOwner(teacherId) && request.resource.data.questionnaireId == questionnaireId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.questionnaireId == questionnaireId;
    }

     /**
     * @description Allows a teacher to manage tests.
     * @path /teachers/{teacherId}/tests/{testId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (update): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @principle Teacher ownership for tests.
     */
    match /teachers/{teacherId}/tests/{testId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow update: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to manage test submissions for their tests.
     * @path /teachers/{teacherId}/tests/{testId}/submissions/{submissionId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.testId == testId;
     * @allow (update): if isExistingOwner(teacherId) && request.resource.data.testId == testId;
     * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.testId == testId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.testId != testId;
     * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.testId != testId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.testId != testId;
     * @principle Teacher ownership for test submissions.
     */
    match /teachers/{teacherId}/tests/{testId}/submissions/{submissionId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.testId == testId;
      allow update: if isExistingOwner(teacherId) && request.resource.data.testId == testId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.testId == testId;
    }

    /**
     * @description Allows a teacher to manage strategic plans.
     * @path /teachers/{teacherId}/strategicPlans/{planId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (update): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @principle Teacher ownership for strategic plans.
     */
    match /teachers/{teacherId}/strategicPlans/{planId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow update: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to manage schedule items.
     * @path /teachers/{teacherId}/schedule/{scheduleItemId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (update): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @principle Teacher ownership for schedule items.
     */
    match /teachers/{teacherId}/schedule/{scheduleItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow update: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to manage consulting content.
     * @path /teachers/{teacherId}/consultingContent/{contentId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (update): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
     * @principle Teacher ownership for consulting content.
     */
    match /teachers/{teacherId}/consultingContent/{contentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow update: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
    }

    /**
     * @description Allows a teacher to manage login history.
     * @path /teachers/{teacherId}/loginHistory/{historyId}
     * @allow (get, list): if isOwner(teacherId);
     * @allow (create): if isOwner(teacherId);
     * @allow (update): if isExistingOwner(teacherId);
     * @allow (delete): if isExistingOwner(teacherId);
     * @principle Teacher ownership for login history.
     */
    match /teachers/{teacherId}/loginHistory/{historyId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }
    
     /**
         * @description Allows a teacher to manage question-answer pairs.
         * @path /teachers/{teacherId}/questions/{questionId}
         * @allow (get, list): if isOwner(teacherId);
         * @allow (create): if isOwner(teacherId) && request.resource.data.teacherId == teacherId && request.resource.data.studentId != null;
         * @allow (update): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
         * @allow (delete): if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
         * @deny (create): if !isOwner(teacherId) || request.resource.data.teacherId != teacherId;
         * @deny (update): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
         * @deny (delete): if !isExistingOwner(teacherId) || request.resource.data.teacherId != teacherId;
         * @principle Teacher ownership for question-answer management.
         */
    match /teachers/{teacherId}/questions/{questionId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId) && request.resource.data.teacherId == teacherId && request.resource.data.studentId != null;
      allow update: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
      allow delete: if isExistingOwner(teacherId) && request.resource.data.teacherId == teacherId;
    }
    
    /**
     * @description Allows a teacher to manage detailed exam checklists for a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/detailedExamChecklists/{checklistId}
     * @allow (get, list): if isOwner(teacherId) || isOwner(studentId);
     * @allow (create): if isOwner(teacherId) && request.resource.data.studentId == studentId;
     * @allow (update): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @allow (delete): if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
     * @deny (create): if !isOwner(teacherId) || request.resource.data.studentId != studentId;
     * @deny (update): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @deny (delete): if !(isExistingOwner(teacherId) || isExistingOwner(studentId)) || request.resource.data.studentId != studentId;
     * @principle Teachers manage student data.
     */
    match /teachers/{teacherId}/students/{studentId}/detailedExamChecklists/{checklistId} {
      allow get, list: if isOwner(teacherId) || isOwner(studentId);
      allow create: if isOwner(teacherId) && request.resource.data.studentId == studentId;
      allow update: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
      allow delete: if (isExistingOwner(teacherId) || isExistingOwner(studentId)) && request.resource.data.studentId == studentId;
    }

    // ==========================================================================================
    // Helper Functions
    // ==========================================================================================

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user ID matches the provided user ID and the resource exists.
     *              This is used for update and delete operations to prevent acting on non-existent documents.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}