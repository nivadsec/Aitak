rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Allows anyone to read public announcements, but only teachers can create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): Any user can read announcements.
     * @allow (create): A teacher can create a new announcement.
     * @allow (update, delete): Only the teacher who created the announcement can update or delete it.
     * @deny (create, update, delete): An unauthenticated user cannot create, update, or delete announcements.
     * @principle Allows public read access for announcements with owner-only writes.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    /**
     * @description Only allows a user to read their own teacher profile, and only allows creation of teacher profiles.
     * @path /teachers/{teacherId}
     * @allow (get): A user can read their own teacher profile.
     * @allow (create): Any signed-in user can create their own teacher profile.
     * @deny (get): A user cannot read another user's teacher profile.
     * @deny (update, delete, list): No one can update, delete, or list teacher profiles.
     * @principle Enforces document ownership and prevents listing.
     */
    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete, list: if false;
    }

    /**
     * @description Allows a teacher to manage their students' profiles.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list): A teacher can read and list their own students' profiles.
     * @allow (create): A teacher can create a new student profile.
     * @allow (update, delete): A teacher can update or delete a student profile they own.
     * @deny (get, list): A student cannot access teacher's student list.
     * @principle Enforces teacher ownership of student profiles.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list): A teacher can read and list daily reports for their students.
     * @allow (create): A teacher can create a new daily report for a student.
     * @allow (update, delete): A teacher can update or delete a daily report they own.
     * @deny (get, list): A student cannot access a teachers daily reports.
     * @principle Enforces teacher ownership of student daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage subject items for a student's daily report.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list): A teacher can read and list subject items.
     * @allow (create): A teacher can create a new subject item.
     * @allow (update, delete): A teacher can update or delete a subject item.
     * @deny (get, list): A student cannot access a teachers subject items.
     * @principle Enforces teacher ownership of student subject items.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to send messages to all students or a specific student.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get, list): A teacher can read and list their own messages.
     * @allow (create): A teacher can create a new message.
     * @allow (update, delete): A teacher can update or delete a message they own.
     * @deny (get, list): A student cannot access a teachers messages.
     * @principle Enforces teacher ownership of messages.
     */
    match /teachers/{teacherId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to send messages to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get, list): A teacher can read and list messages sent to a specific student.
     * @allow (create): A teacher can create a new message for a specific student.
     * @allow (update, delete): A teacher can update or delete a message they own.
     * @deny (get, list): A student cannot access a teachers messages.
     * @principle Enforces teacher ownership of messages to specific students.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage exam reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/examReports/{reportId}
     * @allow (get, list): A teacher can read and list exam reports for their students.
     * @allow (create): A teacher can create a new exam report for a student.
     * @allow (update, delete): A teacher can update or delete an exam report they own.
     * @deny (get, list): A student cannot access a teachers exam reports.
     * @principle Enforces teacher ownership of student exam reports.
     */
    match /teachers/{teacherId}/students/{studentId}/examReports/{reportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage weekly progress reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId}
     * @allow (get, list): A teacher can read and list weekly progress reports for their students.
     * @allow (create): A teacher can create a new weekly progress report for a student.
     * @allow (update, delete): A teacher can update or delete a weekly progress report they own.
     * @deny (get, list): A student cannot access a teachers weekly progress reports.
     * @principle Enforces teacher ownership of student weekly progress reports.
     */
    match /teachers/{teacherId}/students/{studentId}/weeklyProgress/{reportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage topic investment reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId}
     * @allow (get, list): A teacher can read and list topic investment reports for their students.
     * @allow (create): A teacher can create a new topic investment report for a student.
     * @allow (update, delete): A teacher can update or delete a topic investment report they own.
     * @deny (get, list): A student cannot access a teachers topic investment reports.
     * @principle Enforces teacher ownership of student topic investment reports.
     */
    match /teachers/{teacherId}/students/{studentId}/topicInvestments/{reportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage recommendations for their students.
     * @path /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId}
     * @allow (get, list): A teacher can read and list recommendations for their students.
     * @allow (create): A teacher can create a new recommendation for a student.
     * @allow (update, delete): A teacher can update or delete a recommendation they own.
     * @deny (get, list): A student cannot access a teachers recommendations.
     * @principle Enforces teacher ownership of student recommendations.
     */
    match /teachers/{teacherId}/students/{studentId}/recommendations/{recommendationId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage focus intervals for their students.
     * @path /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId}
     * @allow (get, list): A teacher can read and list focus intervals for their students.
     * @allow (create): A teacher can create a new focus interval for a student.
     * @allow (update, delete): A teacher can update or delete a focus interval they own.
     * @deny (get, list): A student cannot access a teachers focus intervals.
     * @principle Enforces teacher ownership of student focus intervals.
     */
    match /teachers/{teacherId}/students/{studentId}/focusIntervals/{intervalId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage quizzes.
     * @path /teachers/{teacherId}/quizzes/{quizId}
     * @allow (get, list): A teacher can read and list their own quizzes.
     * @allow (create): A teacher can create a new quiz.
     * @allow (update, delete): A teacher can update or delete a quiz they own.
     * @deny (get, list): A student cannot access a teachers quizzes.
     * @principle Enforces teacher ownership of quizzes.
     */
    match /teachers/{teacherId}/quizzes/{quizId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage quiz submissions for their students.
     * @path /teachers/{teacherId}/quizzes/{quizId}/submissions/{submissionId}
     * @allow (get, list): A teacher can read and list quiz submissions for their students.
     * @allow (create): A teacher can create a new quiz submission for a student.
     * @allow (update, delete): A teacher can update or delete a quiz submission they own.
     * @deny (get, list): A student cannot access a teachers quiz submissions.
     * @principle Enforces teacher ownership of student quiz submissions.
     */
    match /teachers/{teacherId}/quizzes/{quizId}/submissions/{submissionId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage strategic plans.
     * @path /teachers/{teacherId}/strategicPlans/{planId}
     * @allow (get, list): A teacher can read and list their own strategic plans.
     * @allow (create): A teacher can create a new strategic plan.
     * @allow (update, delete): A teacher can update or delete a strategic plan they own.
     * @deny (get, list): A student cannot access a teachers strategic plans.
     * @principle Enforces teacher ownership of strategic plans.
     */
    match /teachers/{teacherId}/strategicPlans/{planId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage schedule items.
     * @path /teachers/{teacherId}/schedule/{scheduleItemId}
     * @allow (get, list): A teacher can read and list their own schedule items.
     * @allow (create): A teacher can create a new schedule item.
     * @allow (update, delete): A teacher can update or delete a schedule item they own.
     * @deny (get, list): A student cannot access a teachers schedule items.
     * @principle Enforces teacher ownership of schedule items.
     */
    match /teachers/{teacherId}/schedule/{scheduleItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage consulting content.
     * @path /teachers/{teacherId}/consultingContent/{contentId}
     * @allow (get, list): A teacher can read and list their own consulting content.
     * @allow (create): A teacher can create new consulting content.
     * @allow (update, delete): A teacher can update or delete consulting content they own.
     * @deny (get, list): A student cannot access a teachers consulting content.
     * @principle Enforces teacher ownership of consulting content.
     */
    match /teachers/{teacherId}/consultingContent/{contentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update, delete: if isOwner(teacherId);
    }
  }
}