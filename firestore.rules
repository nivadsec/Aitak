/**
 * @fileoverview Firestore Security Rules for the آی‌تاب system.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for teachers managing student data,
 * combined with public read access for announcements. Teachers can only manage their
 * own profiles and the data associated with their students.
 *
 * Data Structure:
 * - /announcements/{announcementId}: Public announcements.
 * - /teachers/{teacherId}: Teacher profiles, where {teacherId} is the Firebase Auth UID.
 * - /teachers/{teacherId}/students/{studentId}: Student profiles managed by a teacher.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}: Daily reports for students.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}: Subject items for daily reports.
 * - /teachers/{teacherId}/messages/{messageId}: Messages sent by a teacher to all of their students.
 * - /teachers/{teacherId}/students/{studentId}/messages/{messageId}: Messages sent by a teacher to a specific student.
 *
 * Key Security Decisions:
 * - Teachers can only manage their own profiles (ownership).
 * - Student data is managed and scoped under each teacher's profile (ownership).
 * - Announcements are publicly readable.
 * - Listing of all teachers or students is disallowed. Only a teacher can list their own students.
 * - Data relationships are enforced through path-based authorization and denormalized data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements, but only allows teachers to create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list)
     * @allow (create) if isSignedIn() && request.resource.data.teacherId == request.auth.uid
     * @allow (update, delete) if isSignedIn() && resource.data.teacherId == request.auth.uid
     * @deny (create) if !isSignedIn()
     * @deny (update, delete) if !isSignedIn()
     * @principle Allows public read access to announcements while restricting write access to authorized teachers only
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.teacherId;
      allow update: if isSignedIn() && isExistingOwner(resource.data.teacherId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.teacherId);
    }

    /**
     * @description Allows a teacher to manage their own profile.
     * @path /teachers/{teacherId}
     * @allow (get) if isOwner(teacherId)
     * @allow (create) if isOwner(teacherId)
     * @allow (update, delete) if isExistingOwner(teacherId)
     * @deny (get) if !isOwner(teacherId)
     * @deny (create) if !isOwner(teacherId)
     * @deny (update, delete) if !isExistingOwner(teacherId)
     * @principle Enforces document ownership for teacher profiles.
     */
    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId);
      allow list: if false;
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage students under their profile.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get, list) if isOwner(teacherId)
     * @allow (create) if isOwner(teacherId)
     * @allow (update, delete) if isExistingOwner(teacherId)
     * @deny (get, list) if !isOwner(teacherId)
     * @deny (create) if !isOwner(teacherId)
     * @deny (update, delete) if !isExistingOwner(teacherId)
     * @principle Enforces document ownership for student profiles.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get, list) if isOwner(teacherId)
     * @allow (create) if isOwner(teacherId)
     * @allow (update, delete) if isExistingOwner(teacherId)
     * @deny (get, list) if !isOwner(teacherId)
     * @deny (create) if !isOwner(teacherId)
     * @deny (update, delete) if !isExistingOwner(teacherId)
     * @principle Enforces document ownership for daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage subject items for their students' daily reports.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get, list) if isOwner(teacherId)
     * @allow (create) if isOwner(teacherId)
     * @allow (update, delete) if isExistingOwner(teacherId)
     * @deny (get, list) if !isOwner(teacherId)
     * @deny (create) if !isOwner(teacherId)
     * @deny (update, delete) if !isExistingOwner(teacherId)
     * @principle Enforces document ownership for subject items.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage messages that they've sent to all of their students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get, list) if isOwner(teacherId)
     * @allow (create) if isOwner(teacherId)
     * @allow (update, delete) if isExistingOwner(teacherId);
     * @deny (get, list) if !isOwner(teacherId)
     * @deny (create) if !isOwner(teacherId)
     * @deny (update, delete) if !isExistingOwner(teacherId);
     * @principle Enforces document ownership for messages sent to all students.
     */
    match /teachers/{teacherId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage messages that they've sent to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get, list) if isOwner(teacherId)
     * @allow (create) if isOwner(teacherId)
     * @allow (update, delete) if isExistingOwner(teacherId);
     * @deny (get, list) if !isOwner(teacherId)
     * @deny (create) if !isOwner(teacherId)
     * @deny (update, delete) if !isExistingOwner(teacherId);
     * @principle Enforces document ownership for messages sent to a specific student.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get, list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}