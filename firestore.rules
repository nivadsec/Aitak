/**
 * @file Firebase Security Rules for the آی‌تاب system.
 *
 * @Core Philosophy:
 * This ruleset enforces a hierarchical data ownership model where teachers manage student data.
 * Each teacher has exclusive access to the student profiles and associated data (daily reports, subject items) under their control.
 * Announcements are publicly readable, but only teachers can create them.
 *
 * @Data Structure:
 * - /announcements/{announcementId}: Public announcements.
 * - /teachers/{teacherId}: Teacher profiles, where teacherId matches the Firebase auth UID.
 * - /teachers/{teacherId}/students/{studentId}: Student profiles managed by a specific teacher.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}: Daily reports for a student.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}: Subject items for a specific daily report.
 * - /teachers/{teacherId}/messages/{messageId}: Messages sent by a teacher to all students.
 * - /teachers/{teacherId}/students/{studentId}/messages/{messageId}: Messages sent by a teacher to a specific student.
 *
 * @Key Security Decisions:
 * - Teachers have full control over student data nested under their teacher ID.
 * - Students cannot directly modify their data; changes must be made through a teacher account.
 * - Listing students, daily reports, and subject items is allowed only within the scope of a teacher's managed students.
 * - The rules enforce authorization independence: access to a child document (e.g., daily report) is authorized directly
 *   without needing to read the parent document (e.g., student profile). This avoids costly `get()` operations in the rules.
 * - Only teachers can create announcements. All users can read announcements.
 *
 * @Denormalization for Authorization:
 *  The 'teacherId' and 'studentId' are denormalized into the DailyReport and SubjectItem documents to enable
 *  direct authorization checks without needing to query parent documents.
 *
 * @Structural Segregation:
 *  Student data is segregated under each teacher's ID, ensuring that teachers can only access the data they manage.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements, but only teachers can create, update, or delete them.
     * @path /announcements/{announcementId}
     * @allow (get, list): if true
     * @allow (create): if isSignedIn() && request.auth.uid == request.resource.data.teacherId
     * @allow (update): if isSignedIn() && resource.data.teacherId == request.auth.uid
     * @allow (delete): if isSignedIn() && resource.data.teacherId == request.auth.uid
     * @deny (create): if !isSignedIn()
     * @deny (update): if !isSignedIn() || resource.data.teacherId != request.auth.uid
     * @deny (delete): if !isSignedIn() || resource.data.teacherId != request.auth.uid
     * @principle Allows public read access, but restricts writes to authorized teachers.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.teacherId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.teacherId);
    }

    /**
     * @description Allows a teacher to manage their own profile data.
     * @path /teachers/{teacherId}
     * @allow (get): if isSignedIn() && isOwner(teacherId)
     * @allow (list): if false; // Prevent listing all teachers
     * @allow (create): if isSignedIn() && isOwner(teacherId)
     * @allow (update): if isSignedIn() && isExistingOwner(teacherId)
     * @allow (delete): if isSignedIn() && isExistingOwner(teacherId)
     * @deny (get): if !isSignedIn() || !isOwner(teacherId)
     * @deny (create): if !isSignedIn() || !isOwner(teacherId)
     * @deny (update): if !isSignedIn() || !isOwner(teacherId)
     * @deny (delete): if !isSignedIn() || !isOwner(teacherId)
     * @principle Enforces document ownership for writes and reads.
     */
    match /teachers/{teacherId} {
      allow get: if isSignedIn() && isOwner(teacherId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isExistingOwner(teacherId);
      allow delete: if isSignedIn() && isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage students under their control.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow (get): if isSignedIn() && isOwner(teacherId)
     * @allow (list): if isSignedIn() && isOwner(teacherId)
     * @allow (create): if isSignedIn() && isOwner(teacherId)
     * @allow (update): if isSignedIn() && isExistingOwner(teacherId)
     * @allow (delete): if isSignedIn() && isExistingOwner(teacherId)
     * @deny (get): if !isSignedIn() || !isOwner(teacherId)
     * @deny (list): if !isSignedIn() || !isOwner(teacherId)
     * @deny (create): if !isSignedIn() || !isOwner(teacherId)
     * @deny (update): if !isSignedIn() || !isOwner(teacherId)
     * @deny (delete): if !isSignedIn() || !isOwner(teacherId)
     * @principle Restricts access to a teacher's own student data.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get: if isSignedIn() && isOwner(teacherId);
      allow list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isExistingOwner(teacherId);
      allow delete: if isSignedIn() && isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow (get): if isSignedIn() && isOwner(teacherId)
     * @allow (list): if isSignedIn() && isOwner(teacherId)
     * @allow (create): if isSignedIn() && isOwner(teacherId)
     * @allow (update): if isSignedIn() && isExistingOwner(teacherId);
     * @allow (delete): if isSignedIn() && isExistingOwner(teacherId);
     * @deny (get): if !isSignedIn() || !isOwner(teacherId)
     * @deny (list): if !isSignedIn() || !isOwner(teacherId)
     * @deny (create): if !isSignedIn() || !isOwner(teacherId)
     * @deny (update): if !isSignedIn() || !isOwner(teacherId)
     * @deny (delete): if !isSignedIn() || !isOwner(teacherId)
     * @principle Enforces teacher-based ownership of daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get: if isSignedIn() && isOwner(teacherId);
      allow list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isExistingOwner(teacherId);
      allow delete: if isSignedIn() && isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage subject items for a specific daily report.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow (get): if isSignedIn() && isOwner(teacherId)
     * @allow (list): if isSignedIn() && isOwner(teacherId)
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isSignedIn() && isExistingOwner(teacherId);
     * @allow (delete): if isSignedIn() && isExistingOwner(teacherId);
     * @deny (get): if !isSignedIn() || !isOwner(teacherId)
     * @deny (list): if !isSignedIn() || !isOwner(teacherId)
     * @deny (create): if !isSignedIn() || !isOwner(teacherId)
     * @deny (update): if !isSignedIn() || !isOwner(teacherId)
     * @deny (delete): if !isSignedIn() || !isOwner(teacherId)
     * @principle Scopes subject item access to the managing teacher.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get: if isSignedIn() && isOwner(teacherId);
      allow list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isExistingOwner(teacherId);
      allow delete: if isSignedIn() && isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage messages sent to all students
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow (get): if isSignedIn() && isOwner(teacherId);
     * @allow (list): if isSignedIn() && isOwner(teacherId);
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isSignedIn() && isExistingOwner(teacherId);
     * @allow (delete): if isSignedIn() && isExistingOwner(teacherId);
     * @deny (get): if !isSignedIn() || !isOwner(teacherId)
     * @deny (list): if !isSignedIn() || !isOwner(teacherId)
     * @deny (create): if !isSignedIn() || !isOwner(teacherId)
     * @deny (update): if !isSignedIn() || !isOwner(teacherId)
     * @deny (delete): if !isSignedIn() || !isOwner(teacherId)
     * @principle Scopes message access to the managing teacher.
     */
    match /teachers/{teacherId}/messages/{messageId} {
      allow get: if isSignedIn() && isOwner(teacherId);
      allow list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isExistingOwner(teacherId);
      allow delete: if isSignedIn() && isExistingOwner(teacherId);
    }

     /**
     * @description Allows a teacher to manage messages sent to a specific student
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow (get): if isSignedIn() && isOwner(teacherId);
     * @allow (list): if isSignedIn() && isOwner(teacherId);
     * @allow (create): if isSignedIn() && isOwner(teacherId);
     * @allow (update): if isSignedIn() && isExistingOwner(teacherId);
     * @allow (delete): if isSignedIn() && isExistingOwner(teacherId);
     * @deny (get): if !isSignedIn() || !isOwner(teacherId)
     * @deny (list): if !isSignedIn() || !isOwner(teacherId)
     * @deny (create): if !isSignedIn() || !isOwner(teacherId)
     * @deny (update): if !isSignedIn() || !isOwner(teacherId)
     * @deny (delete): if !isSignedIn() || !isOwner(teacherId)
     * @principle Scopes message access to the managing teacher.
     */
    match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
      allow get: if isSignedIn() && isOwner(teacherId);
      allow list: if isSignedIn() && isOwner(teacherId);
      allow create: if isSignedIn() && isOwner(teacherId);
      allow update: if isSignedIn() && isExistingOwner(teacherId);
      allow delete: if isSignedIn() && isExistingOwner(teacherId);
    }

    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}