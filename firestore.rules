/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a hierarchical data model for managing teachers, students, and their associated data (daily reports, subject items, and messages).
 *
 * Data Structure:
 * - /announcements/{announcementId}: Public announcements created by teachers.
 * - /teachers/{teacherId}: Teacher profiles, where teacherId is the Firebase Auth UID.
 * - /teachers/{teacherId}/students/{studentId}: Student profiles managed by a specific teacher.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}: Daily reports for a student.
 * - /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}: Subject items for a daily report.
 * - /teachers/{teacherId}/messages/{messageId}: Messages sent by a teacher to all of their students.
 * - /teachers/{teacherId}/students/{studentId}/messages/{messageId}: Messages sent by a teacher to a specific student.
 *
 * Key Security Decisions:
 * - Teachers can only manage their own profiles (ownership model).
 * - Teachers can manage student data and messages scoped under their teacher ID.
 * - Public announcements are readable by everyone, but only creatable by teachers.
 *
 * Denormalization for Authorization:
 * The rules leverage the hierarchical structure (teacherId, studentId) present in the paths to authorize access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read announcements, but only teachers can create them.
     * @path /announcements/{announcementId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
     * @allow update: if false;
     * @allow delete: if false;
     * @deny create: if !isSignedIn();
     * @deny update: if true;
     * @deny delete: if true;
     * @principle Public read, teacher-only write access for announcements.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows a teacher to manage their own profile.
     * @path /teachers/{teacherId}
     * @allow get: if isOwner(teacherId);
     * @allow list: if false;
     * @allow create: if isOwner(teacherId);
     * @allow update: if isExistingOwner(teacherId);
     * @allow delete: if isExistingOwner(teacherId);
     * @deny create: if !isOwner(teacherId);
     * @deny update: if !isOwner(teacherId);
     * @deny delete: if !isOwner(teacherId);
     * @principle Enforces document ownership for teacher profiles.
     */
    match /teachers/{teacherId} {
      allow get: if isOwner(teacherId);
      allow list: if false;
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage student profiles under their control.
     * @path /teachers/{teacherId}/students/{studentId}
     * @allow get: if isOwner(teacherId);
     * @allow list: if isOwner(teacherId);
     * @allow create: if isOwner(teacherId);
     * @allow update: if isExistingOwner(teacherId);
     * @allow delete: if isExistingOwner(teacherId);
     * @deny create: if !isOwner(teacherId);
     * @deny update: if !isOwner(teacherId);
     * @deny delete: if !isOwner(teacherId);
     * @principle Teacher ownership of student profiles.
     */
    match /teachers/{teacherId}/students/{studentId} {
      allow get: if isOwner(teacherId);
      allow list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage daily reports for their students.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}
     * @allow get: if isOwner(teacherId);
     * @allow list: if isOwner(teacherId);
     * @allow create: if isOwner(teacherId);
     * @allow update: if isExistingOwner(teacherId);
     * @allow delete: if isExistingOwner(teacherId);
     * @deny create: if !isOwner(teacherId);
     * @deny update: if !isOwner(teacherId);
     * @deny delete: if !isOwner(teacherId);
     * @principle Teacher ownership of student daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId} {
      allow get: if isOwner(teacherId);
      allow list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }

    /**
     * @description Allows a teacher to manage subject items for a student's daily report.
     * @path /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId}
     * @allow get: if isOwner(teacherId);
     * @allow list: if isOwner(teacherId);
     * @allow create: if isOwner(teacherId);
     * @allow update: if isExistingOwner(teacherId);
     * @allow delete: if isExistingOwner(teacherId);
     * @deny create: if !isOwner(teacherId);
     * @deny update: if !isOwner(teacherId);
     * @deny delete: if !isOwner(teacherId);
     * @principle Teacher ownership of subject items within daily reports.
     */
    match /teachers/{teacherId}/students/{studentId}/dailyReports/{dailyReportId}/subjectItems/{subjectItemId} {
      allow get: if isOwner(teacherId);
      allow list: if isOwner(teacherId);
      allow create: if isOwner(teacherId);
      allow update: if isExistingOwner(teacherId);
      allow delete: if isExistingOwner(teacherId);
    }
     /**
     * @description Allows a teacher to manage messages sent to all students.
     * @path /teachers/{teacherId}/messages/{messageId}
     * @allow get: if isOwner(teacherId);
     * @allow list: if isOwner(teacherId);
     * @allow create: if isOwner(teacherId);
     * @allow update: if isExistingOwner(teacherId);
     * @allow delete: if isExistingOwner(teacherId);
     * @deny create: if !isOwner(teacherId);
     * @deny update: if !isOwner(teacherId);
     * @deny delete: if !isOwner(teacherId);
     * @principle Teacher ownership of messages sent to all students.
     */
    match /teachers/{teacherId}/messages/{messageId} {
       allow get: if isOwner(teacherId);
       allow list: if isOwner(teacherId);
       allow create: if isOwner(teacherId);
       allow update: if isExistingOwner(teacherId);
       allow delete: if isExistingOwner(teacherId);
    }
    /**
     * @description Allows a teacher to manage messages sent to a specific student.
     * @path /teachers/{teacherId}/students/{studentId}/messages/{messageId}
     * @allow get: if isOwner(teacherId);
     * @allow list: if isOwner(teacherId);
     * @allow create: if isOwner(teacherId);
     * @allow update: if isExistingOwner(teacherId);
     * @allow delete: if isExistingOwner(teacherId);
     * @deny create: if !isOwner(teacherId);
     * @deny update: if !isOwner(teacherId);
     * @deny delete: if !isOwner(teacherId);
     * @principle Teacher ownership of messages sent to a specific student.
     */
     match /teachers/{teacherId}/students/{studentId}/messages/{messageId} {
       allow get: if isOwner(teacherId);
       allow list: if isOwner(teacherId);
       allow create: if isOwner(teacherId);
       allow update: if isExistingOwner(teacherId);
       allow delete: if isExistingOwner(teacherId);
    }


    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}